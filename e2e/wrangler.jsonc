// TEST-ONLY configuration for the browser tests (see e2e/worker.ts). Never deploy it.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ping-e2e",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ping-e2e",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "e2e.cloudflareaccess.com",
    "POLICY_AUD": "e2e-aud",
    "ALLOWED_EMAIL": "joaquin@example.com"
  }
}
