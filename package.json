{
  "name": "ping",
  "version": "0.1.0",
  "description": "Stage-1 proof system and template: Worker + D1 + PWA behind Cloudflare Access.",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc && tsc -p e2e",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joakososa/ping.git"
  },
  "bugs": {
    "url": "https://github.com/joakososa/ping/issues"
  },
  "homepage": "https://github.com/joakososa/ping#readme",
  "dependencies": {
    "hono": "^4.13.21",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.167.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
